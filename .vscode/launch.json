{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [".", "--remote-debugging-port=9876"],
      "env": { "ELECTRON_RENDERER_URL": "http://localhost:4200" },
      "outFiles": ["${workspaceFolder}/dist/electron/**/*.mjs"],
      "preLaunchTask": "Build.Main"
    },
    {
      "name": "Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9876,
      "webRoot": "${workspaceFolder}",
      "timeout": 30000
    }
  ],
  "compounds": [
    {
      "name": "Application Debug",
      "configurations": ["Main", "Renderer"],
      "preLaunchTask": "Serve.Renderer"
    }
  ]
}
