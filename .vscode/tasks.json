{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build.Main",
      "type": "shell",
      "command": "npm run electron:build -- --dev",
      "problemMatcher": "$esbuild"
    },
    {
      "label": "Serve.Renderer",
      "type": "shell",
      "command": "npm run ng:serve",
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": { "regexp": "^x\s+(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building",
          "endsPattern": "(Application bundle generation (complete|failed))|(Watch mode enabled)"
        }
      }
    }
  ]
}
