{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.manuelgraf.dep-pin",
  "productName": "dep.pin",
  "asar": true,
  "directories": {
    "output": "release/",
    "buildResources": "src/assets/icons"
  },
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "files": [
    "dist/**/*",
    "!**/*.map",
    "package.json"
  ],
  "win": {
    "icon": "src/assets/icons/favicon.512x512.png",
    "target": [
      "portable"
    ]
  },
  "portable": {
    "splashImage": "src/assets/icons/electron.bmp"
  },
  "mac": {
    "icon": "src/assets/icons/favicon.icns",
    "target": [
      "dmg"
    ]
  },
  "linux": {
    "icon": "src/assets/icons/favicon.512x512.png",
    "target": [
      "AppImage"
    ]
  },
  "publish": {
    "provider": "github",
    "releaseType": "draft"
  }
}
