{
  "name": "dep.pin",
  "productName": "dep.pin",
  "version": "1.1.0",
  "description": "Desktop app to review package.json files, pin dependency versions and run npm audit",
  "author": {
    "name": "Manuel Graf",
    "email": "mail@manuelgraf.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ManuelGraf/dep.pin.git"
  },
  "main": "dist/electron/main.mjs",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n ng,electron \"npm:ng:serve\" \"npm:electron:dev\"",
    "ng:serve": "ng serve",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "wait-on tcp:4200 && npm run electron:build -- --dev && cross-env ELECTRON_RENDERER_URL=http://localhost:4200 electron .",
    "build": "ng build && npm run electron:build",
    "electron:local": "npm run build && electron .",
    "package": "npm run build && electron-builder build --publish=never",
    "release": "npm run build && electron-builder build --publish always",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "e2e:show-trace": "playwright show-trace e2e/tracing/trace.zip",
    "lint": "ng lint",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md"
  },
  "dependencies": {
    "npm-check-updates": "23.1.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.2",
    "@angular/cdk": "22.2.3",
    "@angular/cli": "22.2.2",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "angular-eslint": "22.6.0",
    "concurrently": "10.0.6",
    "conventional-changelog-cli": "5.0.0",
    "cross-env": "10.1.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.3",
    "marked": "18.1.1",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "wait-on": "9.5.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "electron-winstaller": false
  }
}
